  {
    "id": "FW-C01", "category": "change", "expect_success": true,
    "task": "防火墙配置变更：请放通内网 trust 区 10.1.8.0/24 网段访问 DMZ 区 172.16.1.20 主机的 SSH（TCP 22 端口）流量。要求：先查看现有配置，将规则加入候选配置，diff 确认后提交生效，最后用模拟报文验证。",
    "assert": [
      {"type": "rule_present", "match": {"src_zone": "trust", "dst_zone": "dmz", "dst_addr": "172.16.1.20/32", "protocol": "tcp", "dst_port": "22", "action": "allow"}},
      {"type": "revision", "op": ">", "value": 1},
      {"type": "no_pending"},
      {"type": "traffic", "packet": {"src_zone": "trust", "dst_zone": "dmz", "src_addr": "10.1.8.5", "dst_addr": "172.16.1.20", "protocol": "tcp", "dst_port": "22"}, "expect": "allow"}
    ]
  },
